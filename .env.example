# Querier's settings. Copy this to .env (never commit it) and fill in.
#
# `bun run start` / `bun run dev` read .env from the repository's folder;
# `docker compose up` passes it into the container (compose.yaml: env_file).
# Nothing is required: everything has a default.


# ── The sysadmin ────────────────────────────────────────────────────────────
# The one account that needs no directory and no policy: it works when AD or
# the identity provider is down.
#
# Left unset (the default), Querier makes it on its first start and prints its
# generated password to the log (`docker compose logs querier`); the first
# sign-in asks for a password of your own, changed later from the account menu.
# It is kept hashed in <config>/sysadmin.json: delete that and restart for a
# new one (a lost password). QUERIER_ADMIN_USER alone renames it (default admin).
# QUERIER_ADMIN_USER=admin

# Or keep it here instead, changed only here: its name and a hash, never the
# password. Run this, type the password (twice; it doesn't show), and paste the
# line it prints (its b64: form survives .env's $ expansion):
#   bun server/auth/hash.ts           (in the container: docker compose exec querier bun server/auth/hash.ts)
# QUERIER_ADMIN_PASSWORD_HASH=b64:...
#
# Changing either ends the sysadmin's open sessions. (QUERIER_ADMIN_PASSWORD,
# in plain text, also works but is warned about: prefer the hash.)


# ── Where people reach Querier ──────────────────────────────────────────────
# Its https:// address, as people type it. OIDC providers send the browser back
# to <this>/api/auth/oidc/<id>/callback; https:// makes the session cookie
# Secure; behind a proxy that ends TLS, requests from this origin are Querier's own.
# Passwords (the directory's, the sysadmin's) are refused over plain HTTP,
# except on localhost.
# QUERIER_PUBLIC_URL=https://querier.example.com

# The reverse proxy's address(es), comma-separated: only its X-Forwarded-For is
# believed, so the audit log and login throttling see the real client.
# QUERIER_TRUSTED_PROXIES=10.0.0.2

# Opt out of HTTPS, for now: passwords and session cookies are accepted over
# plain HTTP from anywhere, not only localhost. Anyone on the network between
# the browsers and Querier can read them, so only on a network you trust, until
# a certificate is in place (a reverse proxy ending TLS). The server warns on
# start. (Its old name, QUERIER_ALLOW_INSECURE_LOGIN=1, works too.)
# QUERIER_ALLOW_HTTP=1

# The port the server listens on (the container's; compose maps it).
# PORT=3000


# ── Identity providers' secrets ─────────────────────────────────────────────
# Providers (Active Directory over LDAPS, Microsoft Entra ID, Keycloak…) are set
# up in <config>/auth.json: see auth.example.json. A value there written as
# "env:NAME" is read from here, so auth.json needn't hold any secret.
# LDAP_BIND_PASSWORD=
# ENTRA_CLIENT_SECRET=
# KEYCLOAK_CLIENT_SECRET=


# ── Monitoring ──────────────────────────────────────────────────────────────
# A bearer token for Prometheus to scrape /metrics (every kernel's CPU and
# memory). Without one, only the signed-in sysadmin may read it.
#   openssl rand -hex 24
# QUERIER_METRICS_TOKEN=


# ── Paths (the Docker image sets these; change them only outside it) ────────
# Notebooks: <this>/<workspace>/<notebook>/
# QUERIER_NOTEBOOKS=./notebooks
# The config directory: connections.json (credentials), mcp.json, auth.json,
# querier.db (sessions, grants, audit), signing.key, policies/; all mode 600.
# QUERIER_CONFIG_DIR=~/.config/querier
# Each file on its own, if it must live elsewhere:
# QUERIER_AUTH_CONFIG=<config>/auth.json
# QUERIER_DB=<config>/querier.db
# QUERIER_MCP=<config>/mcp.json
# QUERIER_CONNECTIONS=<config>/connections.json


# ── Kernels: how many, and how long ─────────────────────────────────────────
# Each person has their own kernel of a notebook (a microVM each). Running at
# once, everyone's (default: as many 2 GB kernels as the host's memory holds):
# QUERIER_MAX_KERNELS=
# Running at once, one person's:
# QUERIER_MAX_KERNELS_PER_USER=3
# A kernel unused this long stops (its tabs are told; 0: never):
# QUERIER_KERNEL_IDLE_MINUTES=30


# ── Kernels (the Docker image sets these) ───────────────────────────────────
# firecracker: each notebook's kernel in a microVM (the image); unset: local processes
# QUERIER_RUNNER=firecracker
# The Python that runs local kernels, and basalt's binary
# QUERIER_PYTHON=./.venv/bin/python
# BASALT_BIN=basalt
# basalt's language reference, for AI clients (MCP basalt_reference)
# QUERIER_BASALT_DOCS=/opt/querier/basalt-language.md
# The largest file a cell may write to output/ and have kept (bytes; default 2 GiB)
# QUERIER_OUTPUT_MAX=2147483648
# Firecracker's kernel and root disk, and where each VM's files go while it runs
# QUERIER_VM_DIR=/opt/querier/vm
# QUERIER_VM_WORK=/var/lib/querier/vms

# The published image to run (docker compose): a release like 0.1.0, or latest (the newest)
# QUERIER_VERSION=latest
