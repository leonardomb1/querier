{
  "name": "querier",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server/app.ts & bunx --bun vite --config web/vite.config.ts; kill %1",
    "build": "bunx --bun vite build --config web/vite.config.ts",
    "start": "bun server/app.ts",
    "check": "tsc -p . && svelte-check --tsconfig web/tsconfig.json",
    "test": "bun test",
    "nb": "bun scripts/run-notebook.ts"
  },
